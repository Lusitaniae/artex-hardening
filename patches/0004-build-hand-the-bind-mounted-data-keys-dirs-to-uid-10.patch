From 47165a9f63dd9f8684874b9f0491602a8037795c Mon Sep 17 00:00:00 2001
From: hardening <hardening@example.invalid>
Date: Sat, 7 Nov 2026 10:39:32 +0000
Subject: [PATCH 4/9] build: hand the bind-mounted data/keys dirs to uid 10001
 at startup

The unprivileged-user change made `docker compose up` fail on a fresh clone:
compose bind-mounts ./data and ./keys, the Docker daemon creates missing host
directories as root:root, so uid 10001 could not create /app/data/traffic or
write /app/keys/jwt.key. artex exited with code 1 and start.sh's supervisor
looped on the restart backoff.

docker-entrypoint.sh now runs as root under compose (which sets user: "0:0"),
chowns only the two writable volumes (and only entries that are not already
10001:10001, so restarts do not rewrite a large data tree), then drops to
uid 10001 with setpriv. /app/artex and /app/skills stay root-owned and
read-only, so a compromised agent still cannot rewrite the binary or skills.
The image default stays USER artex, so plain `docker run` without host bind
mounts and Kubernetes runAsNonRoot skip the handover entirely.

Verified locally: docker build + docker compose up -d --no-build, postgres and
artex healthy, GET / -> 200, and inside the container pid 1 and artex run as
uid 10001 while writes to /app/skills and /app/artex are denied.
---
 Dockerfile           | 11 +++++++++--
 HARDENING.md         | 19 +++++++++++++++----
 docker-compose.yml   |  4 ++++
 docker-entrypoint.sh | 30 ++++++++++++++++++++++++++++++
 4 files changed, 58 insertions(+), 6 deletions(-)
 create mode 100755 docker-entrypoint.sh

diff --git a/Dockerfile b/Dockerfile
index 632637e..32273c5 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -182,7 +182,9 @@ COPY --from=build /out/artex /app/artex
 # to artex — docker stop only signals PID 1; without forwarding, artex never receives it,
 # cannot shut down gracefully, and is hard-killed by SIGKILL after 10 seconds.
 COPY start.sh /app/start.sh
-RUN chmod +x /app/artex /app/start.sh && mkdir -p /app/keys /app/data
+COPY docker-entrypoint.sh /app/docker-entrypoint.sh
+RUN chmod +x /app/artex /app/start.sh /app/docker-entrypoint.sh \
+    && mkdir -p /app/keys /app/data
 
 # persistence points: data/ (SQLite, task files) and keys/ (jwt.key, via ARTEX_JWT_KEY_DIR)
 # Only the writable paths are handed to the runtime user; the binary and skills stay
@@ -196,6 +198,11 @@ COPY skills/ /app/skills/
 VOLUME ["/app/data", "/app/keys"]
 EXPOSE 8787 8788
 ENV HOME=/home/artex
+# Default user is unprivileged. docker-compose.yml overrides this with `user: "0:0"`
+# because it bind-mounts ./data and ./keys from the host (created root-owned by the
+# daemon); the entrypoint then chowns those two paths and drops back to uid 10001
+# with setpriv before artex runs. A plain `docker run` without host bind mounts, and
+# `kubectl` with runAsNonRoot, use uid 10001 directly and skip the handover.
 USER artex
-ENTRYPOINT ["/app/start.sh"]
+ENTRYPOINT ["/app/docker-entrypoint.sh"]
 CMD ["-addr", ":8787", "-proxy", ":8788"]
