 server/webui_assets.go      | 156 ++++++++++++++++++++++++++++++++++++
 server/webui_assets_test.go | 140 ++++++++++++++++++++++++++++++++
 server/webui_embed.go       |  27 +++----
 3 files changed, 306 insertions(+), 17 deletions(-)
