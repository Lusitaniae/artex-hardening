#!/usr/sbin/nft -f
#
# ARTEX egress containment. Default deny for the lab bridge (172.28.0.0/24).
#
# Sets are intentionally EMPTY here and populated by scripts/egress-apply.sh from
# nftables/*.allow. If that script has not run, every packet from the lab is dropped —
# including your own UI session. That is the correct failure mode.
#
# Apply:  sudo scripts/egress-apply.sh
# Inspect: nft list table inet artex
# Remove: sudo nft delete table inet artex
#
# Everything matching `ip saddr @lab_net` is traffic originating INSIDE the lab
# (containers). Host-originated traffic is untouched.

table inet artex
delete table inet artex

table inet artex {

    set lab_net {
        type ipv4_addr
        flags interval
        # populated by egress-apply.sh: 172.28.0.0/24
    }

    # In-scope engagement targets. Populate from nftables/scope.allow only.
    set in_scope {
        type ipv4_addr
        flags interval
        auto-merge
    }

    # CDN edge (Cloudflare / Fastly / any shared anycast estate the client's
    # names sit behind). Deliberately NOT in in_scope: the lab cannot dial these
    # directly. Only the allowlisting relay may, and only for names squash
    # dstdomain permits. A tool that ignores HTTP_PROXY therefore cannot reach
    # the CDN either -- it hits the default-deny below.
    set cdn_edge {
        type ipv4_addr
        flags interval
        auto-merge
    }

    # LLM provider egress. Populate from nftables/llm.allow (--direct mode only).
    set llm_api {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set resolvers {
        type ipv4_addr
        flags interval
        auto-merge
    }

    # ---------------------------------------------------------------------
    # FORWARD: what the containers may reach.
    # ---------------------------------------------------------------------
    chain forward {
        type filter hook forward priority filter; policy accept;

        # Return traffic for flows we permitted. Required, or nothing works.
        ct state established,related accept

        # --- 1. metadata endpoints. Must precede every accept. ---
        ip saddr @lab_net ip daddr 169.254.169.254 drop
        ip saddr @lab_net ip daddr 169.254.170.2   drop
        ip saddr @lab_net ip daddr 100.100.100.200 drop
        ip saddr @lab_net ip daddr 192.0.0.192     drop

        # --- 2. inside the lab: only the DB port, nothing else. ---
        # docker-proxy answers the loopback publish from the bridge gateway, so
        # app traffic from 172.28.0.1 -> container:8787 has to be allowed.
        ip saddr 172.28.0.1 ip daddr @lab_net tcp dport 8787 ct state new accept
        ip saddr @lab_net ip daddr @lab_net tcp dport 5432 ct state new accept
        ip saddr @lab_net ip daddr @lab_net ct state new drop

        # --- 3. in-scope targets (this is the engagement) ---
        ip saddr @lab_net ip daddr @in_scope accept

        # --- 3b. CDN edge: relay-only, never direct. ---
        # Distinct counter + log prefix, so "a tool ignored HTTP_PROXY and dialed
        # Cloudflare/Fastly itself" is visible instead of blending into the
        # generic deny below. Dropped, not accepted: the relay is a host process
        # and never traverses this chain.
        ip saddr @lab_net ip daddr @cdn_edge counter log prefix "ARTEX-CDN-DIRECT " level info drop

        # --- 4. model egress ---
        # default mode: only the allowlisting relay on the bridge gateway
        ip saddr @lab_net ip daddr 172.28.0.1 tcp dport 3128 ct state new accept
        # --direct mode: pinned provider IPs
        ip saddr @lab_net ip daddr @llm_api tcp dport 443 ct state new accept

        # --- 5. DNS ---
        ip saddr @lab_net ip daddr @resolvers udp dport 53 accept
        ip saddr @lab_net ip daddr @resolvers tcp dport 53 accept

        # --- 6. path-MTU plumbing, or large TLS handshakes blackhole ---
        ip saddr @lab_net icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        ip daddr @lab_net icmp type { destination-unreachable, time-exceeded } ct state related accept

        # --- 7. everything else: log at a survivable rate, then drop ---
        ip saddr @lab_net limit rate 6/minute log prefix "ARTEX-EGRESS-DENY " level warn
        ip saddr @lab_net counter drop
    }

    # ---------------------------------------------------------------------
    # INPUT: defence-in-depth. If someone edits compose to publish 0.0.0.0,
    # the host still refuses these ports from anything but loopback.
    # ---------------------------------------------------------------------
    chain input {
        type filter hook input priority filter; policy accept;

        # Replies to flows accepted below. Without this the accept rules do
        # nothing useful: a SYN is `ct state new` and passes, then every
        # subsequent packet is `established` and falls through to the blanket
        # drop in this chain. Symptom is a TCP handshake that completes and then
        # hangs, with nothing in the squid log — and the README's check
        # (`curl -x` from the host) still passes because host traffic never
        # traverses this chain.
        ct state established,related accept

        # Container -> host traffic arrives here, not on the forward chain
        # (the bridge gateway is a local address). The relay is the one host
        # service the lab is allowed to touch.
        ip saddr @lab_net tcp dport 3128 accept

        # Everything else on these ports stays loopback-only, even if someone
        # later edits compose to publish 0.0.0.0.
        iifname != "lo" tcp dport { 8787, 8788 } counter drop
        iifname != "lo" tcp dport 5432 counter drop
        iifname != "lo" tcp dport 3128 counter drop
    }
}
