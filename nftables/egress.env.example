# Subnet and gateway of the bridge the containers actually run on.
#
# The hardened compose uses 172.28.0.0/24 / 172.28.0.1. If you are running the
# project's own compose instead, Docker picks 172.18.0.0/16 with gateway
# 172.18.0.1 — check with:
#   docker network inspect <project>_default --format '{{range .IPAM.Config}}{{.Subnet}} gw={{.Gateway}}{{end}}'
SUBNET=172.18.0.0/16
GATEWAY=172.18.0.1
