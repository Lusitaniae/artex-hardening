# ARTEX hardened deployment — copy to .env.hardened, chmod 600, fill in every CHANGE_ME.
# preflight.sh fails if any CHANGE_ME remains, or if a password is short.

# ---------- images (DIGEST PINNED, no tags) ----------
# Run scripts/pin-digests.sh to resolve these, then paste the results here.
# ASSUMPTION A1: the locally-built image runs start.sh as its entrypoint.
ARTEX_IMAGE=artex-hardened:CHANGE_ME_COMMIT12
POSTGRES_IMAGE=postgres:17-alpine@sha256:CHANGE_ME

# ---------- database ----------
POSTGRES_USER=artex
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=artex

# ---------- first-run protection (MANDATORY, but not an env var) ----------
# ARTEX does not read a setup token or admin password from the environment. While no
# admin password is stored, the server generates a random 128-bit one-time token at
# startup and prints it to its log. Claim the instance with it:
#   docker compose -f docker-compose.hardened.yml logs artex | grep "Setup token"
# Loopback publishing (below) is what stops a first visitor from claiming it first.
# The token is cleared once a password is stored; then it is single-use.

# ---------- bind / exposure ----------
# The listener is bound by the image's CMD (-addr :8787) and published by
# docker-compose.hardened.yml on 127.0.0.1 only. Do not add a publish on 0.0.0.0;
# reach the UI over SSH or WireGuard. (There is no ARTEX_BIND app variable.)

# ---------- output language ----------
ARTEX_LANG=en

# ---------- LLM ----------
ARTEX_LLM_PROVIDER=openai
ARTEX_LLM_MODEL=deepseek-flash
ARTEX_LLM_BASE_URL=https://api.deepseek.com/v1
ARTEX_LLM_API_KEY=CHANGE_ME
# ASSUMPTION A5: outbound model calls honour an HTTP forward proxy.
# Points at the domain-allowlisted squid relay on the docker bridge gateway.
ARTEX_LLM_PROXY=http://172.28.0.1:3128

# ---------- secrets at rest / keys ----------
# 32 bytes, base64 or hex (`openssl rand -base64 32`). Encrypts the credential
# columns in PostgreSQL. Losing it loses the stored credentials; keep it in the
# password manager AND on the same backup as db_data. Empty = keys/secret.key,
# generated at first start in the artex_keys volume.
ARTEX_SECRET_KEY=CHANGE_ME_32_BYTES_BASE64

# ---------- prompt hardening ----------
# On by default upstream; pinned on. Set 0 only with a documented reason: it is the
# control that keeps target output from being read as instructions.
ARTEX_UNTRUSTED_BOUNDARY=1

# ---------- egress / phone-home ----------
# The update banner would ask api.github.com for the latest release. The egress
# allowlist denies it; keep it off rather than relying on that.
ARTEX_UPDATE_CHECK=0

# ---------- optional notifications ----------
# Any webhook here is an exfil channel. Leave empty unless you control the destination.
# ARTEX_NOTIFY_WEBHOOK=
