# ARTEX hardened deployment — copy to .env.hardened, chmod 600, fill in every CHANGE_ME.
# preflight.sh fails if any CHANGE_ME remains, or if a password is short.

# ---------- images (DIGEST PINNED, no tags) ----------
# Run scripts/pin-digests.sh to resolve these, then paste the results here.
# ASSUMPTION A1: the locally-built image runs start.sh as its entrypoint.
ARTEX_IMAGE=artex-hardened:CHANGE_ME_COMMIT12
POSTGRES_IMAGE=postgres:17-alpine@sha256:CHANGE_ME

# ---------- database ----------
POSTGRES_USER=artex
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=artex

# ---------- first-run protection (MANDATORY) ----------
# Either pin a setup token (recommended) or set the admin password directly.
# Without one of these, whoever reaches the UI first owns the instance.
ARTEX_SETUP_TOKEN=CHANGE_ME_32_BYTES_HEX
# ARTEX_ADMIN_PASSWORD=

# ---------- bind / exposure ----------
# Keep 127.0.0.1. compose publishes 8787 to loopback only; reach it over SSH or WireGuard.
# Do NOT set this to 0.0.0.0 "just to test" — that is how these get owned.
ARTEX_BIND=127.0.0.1

# Empty is correct for the embedded same-origin UI. Populating it widens the API surface.
ARTEX_CORS_ORIGINS=

# ---------- output language ----------
ARTEX_LANG=en

# ---------- LLM ----------
ARTEX_LLM_PROVIDER=openai
ARTEX_LLM_MODEL=deepseek-flash
ARTEX_LLM_BASE_URL=https://api.deepseek.com/v1
ARTEX_LLM_API_KEY=CHANGE_ME
# ASSUMPTION A5: outbound model calls honour an HTTP forward proxy.
# Points at the domain-allowlisted squid relay on the docker bridge gateway.
ARTEX_LLM_PROXY=http://172.28.0.1:3128

# ---------- state ----------
# ASSUMPTION A3: writable path for evidence/screenshots inside the container.
ARTEX_STATE_DIR=/opt/artex/state

# ---------- optional notifications ----------
# Any webhook here is an exfil channel. Leave empty unless you control the destination.
# ARTEX_NOTIFY_WEBHOOK=
